        "type": "object",
        "properties": {
          "wavelength": {
            "type": "number",
            "description": "Wavelength (nm)"
          },
          "value": {
            "type": "number",
            "description": "Measured absorbance/intensity"
          }
        },
        "required": [
          "wavelength",
          "value"
        ]
      },
      "NirsSampleSchema": {
        "type": "object",
        "properties": {
          "sampleId": {
            "type": "number",
            "description": "Unique sample ID"
          },
          "nirsData": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NirsDataPointSchema"
            },
            "description": "Spectral values for this sample"
          },
          "crop": {
            "type": "string",
            "nullable": true,
            "description": "Crop name"
          },
          "qualityLab": {
            "type": "string",
            "nullable": true,
            "description": "Quality lab name"
          },
          "nirModel": {
            "type": "string",
            "nullable": true,
            "description": "NIR model used"
          },
          "species": {
            "type": "string",
            "nullable": true,
            "description": "Species name"
          },
          "plantingDate": {
            "type": "string",
            "nullable": true,
            "description": "Planting date (YYYY-MM-DD)"
          },
          "physiologicalStage": {
            "type": "string",
            "nullable": true,
            "description": "Physiological stage"
          },
          "productType": {
            "type": "string",
            "nullable": true,
            "description": "Product type"
          }
        },
        "required": [
          "sampleId",
          "nirsData"
        ]
      },
      "NirsResponseSchema": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/NirsSampleSchema"
        }
      },
