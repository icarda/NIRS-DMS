            "description": "Species name"
          },
          "plantingYear": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "nullable": true,
            "description": "Planting year (YYYY)"
          },
          "sampleDate": {
            "type": "string",
            "nullable": true,
            "description": "Sample collection date (YYYY-MM-DD)"
          },
          "physiologicalStage": {
            "type": "string",
            "nullable": true,
            "description": "Physiological stage name"
          },
          "productType": {
            "type": "string",
            "nullable": true,
            "description": "Product type name"
          }
        }
      },
      "NirsResponse": {},
      "TraitFilterSchema": {
        "type": "object",
        "properties": {
          "crop": {
            "type": "string",
            "nullable": true,
            "description": "Crop name"
          },
          "qualityLab": {
            "type": "string",
            "nullable": true,
            "description": "Quality lab name"
          },
          "nirModel": {
            "type": "string",
            "nullable": true,
            "description": "NIR model name"
          },
          "species": {
            "type": "string",
            "nullable": true,
            "description": "Species name"
          },
          "plantingYear": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "nullable": true,
            "description": "Planting year (YYYY)"
          },
          "startDate": {
            "type": "string",
            "nullable": true,
            "description": "Sample Date: Start date (YYYY-MM-DD)"
          },
          "endDate": {
            "type": "string",
            "nullable": true,
            "description": "Sample Date: End date (YYYY-MM-DD)"
          },
          "physiologicalStage": {
            "type": "string",
            "nullable": true,
            "description": "Physiological stage name"
          },
          "productType": {
            "type": "string",
            "nullable": true,
            "description": "Product type name"
          },
          "traitName": {
            "type": "string",
            "minLength": 1,
            "description": "Trait name(s), required. Supports comma-separated values"
          }
        },
        "required": [
          "traitName"
        ]
      },
      "TraitResponseSchema": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TraitSampleSchema"
        }
      },
