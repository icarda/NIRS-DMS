        "type": "object",
        "properties": {
          "traitName": {
            "type": "string",
            "description": "Name of the trait"
          },
          "measuredValue": {
            "type": "number",
            "nullable": true,
            "description": "Measured value from wet chemistry"
          },
          "predictedValue": {
            "type": "number",
            "nullable": true,
            "description": "Predicted value (if available)"
          },
          "year": {
            "type": "number",
            "description": "Year of measurement"
          }
        },
        "required": [
          "traitName",
          "year"
        ]
      },
      "TraitSampleSchema": {
        "type": "object",
        "properties": {
          "sampleId": {
            "type": "number",
            "description": "Unique sample ID"
          },
          "crop": {
            "type": "string",
            "nullable": true,
            "description": "Crop name"
          },
          "qualityLab": {
            "type": "string",
            "nullable": true,
            "description": "Quality lab name"
          },
          "nirModel": {
            "type": "string",
            "nullable": true,
            "description": "NIR model used"
          },
          "species": {
            "type": "string",
            "nullable": true,
            "description": "Species name"
          },
          "plantingDate": {
            "type": "string",
            "nullable": true,
            "description": "Planting date (YYYY-MM-DD)"
          },
          "physiologicalStage": {
            "type": "string",
            "nullable": true,
            "description": "Physiological stage"
          },
          "productType": {
            "type": "string",
            "nullable": true,
            "description": "Product type"
          },
          "traits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TraitDataPointSchema"
            },
            "description": "List of traits for this sample"
          }
        },
        "required": [
          "sampleId",
          "traits"
        ]
      }
